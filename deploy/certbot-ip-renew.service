[Unit]
Description=Renew the public IP TLS certificate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/certbot-ip/bin/certbot renew --config-dir /etc/letsencrypt-ip --work-dir /var/lib/certbot-ip --logs-dir /var/log/letsencrypt-ip --non-interactive --no-random-sleep-on-renew --quiet
